{
  "name": "Obrex Local 2.0",
  "short_name": "Obrex",
  "description": "Controle local de obras, recebimentos e comprovantes no Android",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0b0b0b",
  "theme_color": "#f47b20",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "orientation": "portrait",
  "scope": "./",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "prefer_related_applications": false
}